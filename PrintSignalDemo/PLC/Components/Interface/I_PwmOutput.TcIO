    <Method Name="SetDutyCycle" Id="{1913f300-7f9e-4c10-88e9-6dcd26141866}">
      <Declaration><![CDATA[// Sets the PWM duty cycle in percent. Returns FALSE and keeps the previous value if DutyCycle is outside 0..100 %.
METHOD SetDutyCycle : BOOL
VAR_INPUT
	DutyCycle : LREAL; // [%]
END_VAR]]></Declaration>
    </Method>
    <Method Name="SetFrequency" Id="{b7395c19-bb42-402b-a2a6-6bcc87f5f850}">
      <Declaration><![CDATA[// Sets the PWM frequency in Hz. Returns FALSE and keeps the previous value if Frequency is negative.
