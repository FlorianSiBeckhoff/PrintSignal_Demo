<div
  id="Home"
  data-tchmi-type="TcHmi.Controls.System.TcHmiContent"
  data-tchmi-top="0"
  data-tchmi-left="0"
  data-tchmi-width="100"
  data-tchmi-height="100"
 data-tchmi-height-mode="Content" data-tchmi-height-unit="%" data-tchmi-width-mode="Value" data-tchmi-width-unit="%"><div id="OperationGrid" data-tchmi-type="TcHmi.Controls.System.TcHmiGrid" data-hmigpt-select="false" data-tchmi-height="300" data-tchmi-height-mode="Content" data-tchmi-height-unit="px" data-tchmi-left="1" data-tchmi-left-unit="%" data-tchmi-min-width="800" data-tchmi-min-width-unit="px" data-tchmi-top="16" data-tchmi-top-unit="px" data-tchmi-width="98" data-tchmi-width-unit="%">
<script data-tchmi-target-attribute="data-tchmi-column-options" type="application/json">
[{"width": 1, "widthMode": "Value", "widthUnit": "factor", "overflow": false}, {"width": 3, "widthMode": "Value", "widthUnit": "factor", "overflow": false}]
</script>
<script data-tchmi-target-attribute="data-tchmi-row-options" type="application/json">
[{"height": 1, "heightMode": "Content", "heightUnit": "factor", "overflow": false}]
</script>

<div id="OperationModeIcon" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiImage" data-hmigpt-select="false" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="0" data-tchmi-height="24" data-tchmi-height-unit="px" data-tchmi-left="8" data-tchmi-left-unit="px" data-tchmi-src="data:image/svg+xml;base64," data-tchmi-top="8" data-tchmi-top-unit="px" data-tchmi-width="24" data-tchmi-width-unit="px">
</div>
<div id="OperationModeTitle" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-hmigpt-select="false" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="0" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="40" data-tchmi-left-unit="px" data-tchmi-right="0" data-tchmi-text="Operation Mode" data-tchmi-text-font-size="20" data-tchmi-text-horizontal-alignment="Left" data-tchmi-text-vertical-alignment="Center" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-width="150" data-tchmi-width-mode="Content" data-tchmi-width-unit="px" data-tchmi-word-wrap="True">
</div>
<div id="OperationModeToggle" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiMultiState" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="0" data-tchmi-left="8" data-tchmi-left-unit="px" data-tchmi-top="48" data-tchmi-top-unit="px" data-tchmi-width="200" data-tchmi-width-unit="px" data-tchmi-height="48" data-tchmi-height-unit="px" data-tchmi-state="%s%PLC1.MAIN.OperationMode%/s%" data-tchmi-fallback-text="---" data-tchmi-text-font-size="18" data-tchmi-text-font-weight="Bold" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-vertical-alignment="Center" data-tchmi-icon-width="28" data-tchmi-icon-width-unit="px" data-tchmi-icon-height="28" data-tchmi-icon-height-unit="px" data-tchmi-icon-horizontal-alignment="Left" data-tchmi-icon-vertical-alignment="Center" data-tchmi-tooltip="Click to toggle Manual / Auto">
<script data-tchmi-target-attribute="data-tchmi-state-list" type="application/json">
[
  {
    "state": 0,
    "stateText": "Manual",
    "stateIcon": "data:image/svg+xml;base64,",
    "stateBackgroundColor": {
      "color": "#d98b00"
    },
    "stateTextColor": {
      "color": "#ffffff"
    }
  },
  {
    "state": 1,
    "stateText": "Auto",
    "stateIcon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSJub25lIiBzdHJva2U9IiNmZmZmZmYiIHN0cm9rZS13aWR0aD0iMi41Ij48Y2lyY2xlIGN4PSIxMiIgY3k9IjEyIiByPSI5Ii8+PC9zdmc+",
    "stateBackgroundColor": {
      "color": "#2e9e44"
    },
    "stateTextColor": {
      "color": "#ffffff"
    }
  }
]
</script>
<script data-tchmi-target-attribute="data-tchmi-fallback-background-color" type="application/json">
{
  "color": "#5a5f66"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-icon-padding" type="application/json">
{
  "left": 14,
  "leftUnit": "px",
  "top": 0,
  "topUnit": "px",
  "right": 0,
  "rightUnit": "px",
  "bottom": 0,
  "bottomUnit": "px"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-border-radius" type="application/json">
{
  "topLeft": 24,
  "topLeftUnit": "px",
  "topRight": 24,
  "topRightUnit": "px",
  "bottomRight": 24,
  "bottomRightUnit": "px",
  "bottomLeft": 24,
  "bottomLeftUnit": "px"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "OperationModeToggle.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Toggle MAIN.OperationMode between manual (0) and auto (1)",
          "var current = TcHmi.Controls.get('OperationModeToggle').getState();",
          "TcHmi.Symbol.writeEx('%s%PLC1.MAIN.OperationMode%/s%', current === 1 ? 0 : 1);"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="PwmOutputPanel" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-grid-column-index="1" data-tchmi-grid-row-index="0" data-tchmi-left="16" data-tchmi-left-unit="px" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-width="440" data-tchmi-width-unit="px" data-tchmi-height="316" data-tchmi-height-unit="px" data-tchmi-target-user-control="UserControls/PwmOutput_HMI.usercontrol" data-tchmi-data="%s%ADS.PLC1.MAIN.PwmHmi.PwmOutput_HMI%/s%">
</div>
<div id="EncoderVelocityPanel" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-grid-column-index="1" data-tchmi-grid-row-index="0" data-tchmi-left="472" data-tchmi-left-unit="px" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-width="440" data-tchmi-width-unit="px" data-tchmi-height="196" data-tchmi-height-unit="px" data-tchmi-target-user-control="UserControls/AxisVelocity_HMI.usercontrol" data-tchmi-data="%s%ADS.PLC1.MAIN.EncoderAxis_HMI.AxisPTP_HMI%/s%">
</div>
</div>
</div>
